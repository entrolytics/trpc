{
  "name": "@entrolytics/trpc-client",
  "version": "2.3.2",
  "description": "tRPC client for Entrolytics API",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "lint": "vp lint --fix . && vp fmt --write .",
    "lint:check": "vp lint . && vp fmt --check .",
    "lint:fix-unsafe": "vp lint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously .",
    "format": "vp fmt --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/api-types": "2.4.4",
    "@entrolytics/shared": "^2.4.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plus": "^0.2.8"
  },
  "packageManager": "pnpm@11.21.0"
}
